{
  "realm": "commerce-local",
  "enabled": true,
  "displayName": "Commerce LOCAL DEV (do not use in production)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "runs:read",
      "description": "Read analysis runs and approvals (development-only realm)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "runs:write",
      "description": "Create analysis runs (development-only realm)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "approvals:write",
      "description": "Approve or reject approvals (development-only realm)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "commerce-local-client",
      "name": "Commerce local client-credentials client (DEV ONLY)",
      "description": "Confidential client for local client-credentials API testing. Development-only; loopback-only; least privilege.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-not-a-real-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "runs:read",
        "runs:write",
        "approvals:write"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api://multi-agent-commerce",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
