# Multi-Agent Commerce Operations Platform — environment configuration
# Copy this file to .env and fill in real values before running locally or via Docker Compose (`docker compose`).

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "github-models" (development) or "azure-openai" (production)
LLM_PROVIDER=github-models
LLM_API_KEY=
LLM_TIMEOUT=30s
LLM_MAX_RESPONSE_CHARACTERS=32768

# Azure OpenAI — required when LLM_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_CHAT_DEPLOYMENT=gpt-4o

# ── Local observability ───────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ── PostgreSQL (persistence) ──────────────────────────────────────────────────
# Used by Docker Compose to provision the database and by the app to connect.
# Never commit a real password; pick a strong local value.
POSTGRES_PASSWORD=
# For running the app outside compose, point it at your database directly:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/commerce
# SPRING_DATASOURCE_USERNAME=commerce
# SPRING_DATASOURCE_PASSWORD=

# ── Redis (distributed coordination) ──────────────────────────────────────────
REDIS_PASSWORD=
# PLATFORM_REDIS_ENABLED=true requires a reachable Redis; the dev profile
# defaults it to false (in-memory single-JVM coordination) when unset.
# PLATFORM_REDIS_ENABLED=true

# ── OAuth2 / OIDC resource server ─────────────────────────────────────────────
# The API is an OAuth2 resource server with NO static bypass. Provide a real
# issuer and the audience(s) the API accepts. Required to start the app.
OAUTH2_ISSUER_URI=https://login.example.com/tenant
OAUTH2_AUDIENCE=api://multi-agent-commerce

# ── Commerce Configuration ────────────────────────────────────────────────────
# Unique identifier for the retailer — used to scope inventory and order queries
RETAILER_ID=default-retailer

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for the daily briefing job (default: 06:00 every morning)
# Format: second minute hour day month weekday
BRIEFING_CRON=0 0 6 * * *

ENV=local
