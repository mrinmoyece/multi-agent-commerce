# Multi-Agent Commerce Operations Platform — environment configuration
# Copy this file to .env and fill in real values before running locally or via docker-compose.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "github_models" (free dev tier) or "azure_openai" (production)
LLM_PROVIDER=github_models

# Azure OpenAI — required when LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4o

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token used to post briefing summaries and read deployment info
GITHUB_TOKEN=

# ── Commerce Configuration ────────────────────────────────────────────────────
# Unique identifier for the retailer — used to scope inventory and order queries
RETAILER_ID=default-retailer

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for the daily briefing job (default: 06:00 every morning)
# Format: second minute hour day month weekday
BRIEFING_CRON=0 0 6 * * *

# ── Observability ─────────────────────────────────────────────────────────────
ENV=local

# ── Build-time (optional) ─────────────────────────────────────────────────────
# NVD API key to avoid rate-limiting during the OWASP dependency-check CVE feed sync.
NVD_API_KEY=
